{
    "java.configuration.updateBuildConfiguration": "automatic",
    "git.detectSubmodules": false,
    "java.import.gradle.enabled": false,
    "java.gradle.buildServer.enabled": "off",
    "java.autobuild.enabled": false,
    "gradle.autoDetect": "off",
    "gradle.nestedProjects": false,
    "cmake.ctest.neverDebugTestsWithLaunchConfiguration": false,
    "files.autoSave": "afterDelay",
    "files.exclude": {
        "**/build": true,
        "**/out": true,
        "**/android/app/.cxx": true,
        "**/android/.gradle": true,
        "**/android/.idea": true
    },
    "search.exclude": {
        "**/build": true,
        "**/out": true,
        "**/android/app/.cxx": true,
        "**/android/.gradle": true,
        "**/android/.idea": true
    },
    "editor.formatOnSave": true,
    "git.autofetch": true,
    // Automatically configure CMake whenever you modify and save CMakeLists.txt
    "cmake.configureOnEdit": true,
    // Automatically configure CMake when you open a folder containing a CMakeLists.txt
    "cmake.configureOnOpen": true,
    // IMPORTANT: Automatically build the project right before you launch or debug it
    "cmake.buildBeforeRun": true,
    "cmake.generator": "Ninja",
    "cmake.buildArgs": [
        "--parallel 8"
    ]
}
