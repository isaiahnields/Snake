{
    "java.configuration.updateBuildConfiguration": "automatic",
    "git.detectSubmodules": false,
    "java.import.gradle.enabled": false,
    "java.gradle.buildServer.enabled": "off",
    "java.autobuild.enabled": false,
    "gradle.autoDetect": "off",
    "gradle.nestedProjects": false,
    "cmake.ctest.neverDebugTestsWithLaunchConfiguration": false,
    "files.autoSave": "afterDelay",
    "files.exclude": {
        "**/out": true,
        "**/android/app/.cxx": true,
        "**/android/.gradle": true,
        "**/android/.idea": true
    },
    "search.exclude": {
        "**/out": true,
        "**/android/app/.cxx": true,
        "**/android/.gradle": true,
        "**/android/.idea": true
    },
    "editor.formatOnSave": true,
    "git.autofetch": true,
    // Automatically configure CMake whenever you modify and save CMakeLists.txt
    "cmake.configureOnEdit": true,
    // Automatically configure CMake when you open a folder containing a CMakeLists.txt
    "cmake.configureOnOpen": true,
    // IMPORTANT: Automatically build the project right before you launch or debug it
    "cmake.buildBeforeRun": true,
    "cmake.generator": "Ninja",
    "cmake.buildArgs": [
        "--parallel 12"
    ],
    "cmake.ctest.allowParallelJobs": false,
    "cmake.ctest.parallelJobs": 1,
    "window.title": "${rootName} — ${activeEditorShort}",
    // 1. Enable clang-tidy and make it run automatically on open and save
    "C_Cpp.codeAnalysis.clangTidy.enabled": true,
    // 2. Direct clang-tidy to look for your CMake compile_commands.json
    "C_Cpp.codeAnalysis.clangTidy.useBuildPath": true,
    // 3. Optional: Explicitly point to the build directory if it isn't default
    "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json",
    "editor.formatOnPaste": true
}
